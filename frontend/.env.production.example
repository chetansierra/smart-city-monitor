# Frontend production environment template
# Copy to .env.production and fill in values, OR set these as environment
# variables in your Vercel project settings (recommended).
#
# In Vercel: Project Settings → Environment Variables

# Base URL for all REST API calls.
# Points to your EC2 instance running the API Gateway.
# Use your EC2 public IP or a domain name if you've set one up.
# No trailing slash.
VITE_API_URL=http://<your-ec2-public-ip>:8080/api/v1

# Google Maps API key.
# Restrict this key to your Vercel domain in Google Cloud Console:
# APIs & Services → Credentials → your key → Application restrictions → HTTP referrers
VITE_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>
