# Multi-stage build for Alert Monitor
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the alert monitor
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o alert-monitor ./cmd/alert-monitor

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy binary from builder
COPY --from=builder /app/alert-monitor .

# Run the application
CMD ["./alert-monitor"]
