# Production environment template
# Copy to .env.prod and fill in values from your managed services
#
#   cp .env.prod.example .env.prod
#
# Never commit .env.prod — it contains secrets.

# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Get these from your Neon project dashboard → Connection Details
# Neon is free forever (0.5 GB, auto-suspend when idle — perfect for personal projects).
POSTGRES_HOST=<your-neon-host>.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=smart_city
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_SSLMODE=require
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_MAX_IDLE_CONNECTIONS=3

# ── Redis (self-hosted in Docker on EC2) ──────────────────────────────────────
# Redis runs as a container in docker-compose.prod.yml.
# Upstash free tier is only 10K commands/day; this app generates ~200 cmds/sec.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Kafka (KRaft, self-hosted in Docker on EC2) ───────────────────────────────
# Kafka runs without Zookeeper (KRaft mode). Clients connect on port 9092.
KAFKA_BROKERS=kafka:9092
KAFKA_INTERNAL_BROKERS=kafka:9092
KAFKA_TOPIC_SENSOR_READINGS=sensor-readings
KAFKA_TOPIC_DLQ=sensor-readings-dlq
KAFKA_TOPIC_ANOMALIES=sensor-anomalies
KAFKA_TOPIC_EVENTS=sensor-events
KAFKA_CONSUMER_GROUP_INGESTION=data-ingestion-group
KAFKA_CONSUMER_GROUP_GATEWAY=gateway-group

# ── API Gateway ───────────────────────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
WEBSOCKET_PATH=/ws

# Comma-separated list of allowed frontend origins for CORS.
# Set this to your Vercel deployment URL — no trailing slash.
# Example: https://smart-city.vercel.app
# Use * only for debugging; always restrict in production.
ALLOWED_ORIGINS=https://<your-app>.vercel.app

# ── Sensor Simulator ──────────────────────────────────────────────────────────
SENSOR_COUNT=50
GENERATION_INTERVAL_MS=1000
ENABLE_RUSH_HOUR=true
ENABLE_WEATHER_PATTERNS=true
SIMULATOR_START_EMPTY=false

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=production
